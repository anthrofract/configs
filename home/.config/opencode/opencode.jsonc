{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "default_agent": "plan",
  "agent": {
    "build": {
      "color": "primary",
    },
    "plan": {
      "color": "secondary",
    },
  },
  "instructions": ["AGENTS.md", "AGENTS-GI.md"],
  "server": {
    "port": 4096,
    "hostname": "0.0.0.0",
  },
  "shell": "nu",
  "compaction": {
    "auto": true,
    "prune": true,
  },
  "permission": {
    "question": "deny",
    "external_directory": {
      "/nix/store/**": "allow",
      "/tmp/**": "allow",
      "~/.cargo/**": "allow",
      "~/configs/**": "allow",
      "~/repos/**": "allow",
      "~/work/**": "allow",
    },
  },
  "plugin": ["opencode-claude-auth@latest"],
  "mcp": {
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true,
    },
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (Valhalla)",
      "options": {
        "baseURL": "http://valhalla:11434/v1",
      },
      "models": {
        "qwen3.6:27b": {
          "name": "Qwen3.6 27B",
          "limit": {
            "context": 131072,
            "output": 32768,
          },
        },
        "qwen3.6:27b-mtp-q4_K_M": {
          "name": "Qwen3.6 27B MTP",
          "limit": {
            "context": 131072,
            "output": 32768,
          },
        },
        "qwen3.6:27b-heretic-text-q4_K_M": {
          "name": "Qwen3.6 27B Heretic Text",
          "limit": {
            "context": 131072,
            "output": 32768,
          },
        },
        "fredrezones55/Qwen3.6-27B-Uncensored-HauhauCS-Balanced:IQ4_XS": {
          "name": "Qwen3.6 27B Uncensored Balanced",
          "limit": {
            "context": 131072,
            "output": 32768,
          },
        },
      },
    },
  },
}
